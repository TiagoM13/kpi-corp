{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalEnv": ["NODE_ENV"],
	"globalPassThroughEnv": ["CI"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"env": ["DATABASE_URL", "CORS_ORIGIN", "PORT", "VITE_SERVER_URL"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"db:push": {
			"cache": false,
			"interactive": true
		},
		"db:generate": {
			"cache": false,
			"interactive": true
		},
		"db:migrate": {
			"cache": false,
			"interactive": true
		},
		"db:seed": {
			"cache": false
		},
		"db:studio": {
			"cache": false,
			"persistent": true
		},
		"db:start": {
			"cache": false
		},
		"db:stop": {
			"cache": false
		},
		"db:watch": {
			"cache": false,
			"persistent": true
		},
		"db:down": {
			"cache": false
		}
	}
}
