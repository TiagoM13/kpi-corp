# Copie para apps/server/.env e ajuste conforme necessario.

# Origem permitida para CORS (URL do app web)
CORS_ORIGIN=http://localhost:3001

# Base usada para montar links que o usuario abre no navegador (convite, etc).
# Separada do CORS_ORIGIN de proposito: o CORS pode virar uma lista de origens,
# mas o link de convite precisa de uma URL unica e canonica.
WEB_APP_URL=http://localhost:3001

# Porta em que a API Fastify escuta
PORT=3000

# Postgres local (packages/db/docker-compose.yml -> npm run db:start)
DATABASE_URL=postgresql://kpicorp:kpicorp@localhost:5432/kpicorp

# Chaves para JWT: mínimo 32 caracteres e diferentes entre si.
# Gere com: openssl rand -base64 48
JWT_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
