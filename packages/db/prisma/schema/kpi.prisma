model Kpi {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  description String?
  points      Int
  category    KpiCategory
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())

  assignments KpiAssignment[]

  @@map("kpi")
}

enum KpiCategory {
  PRESENCE
  PERFORMANCE
  BEHAVIOR
  INITIATIVE

  @@map("kpi_category")
}
