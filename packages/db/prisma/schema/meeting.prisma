model Meeting {
  id        String    @id @default(uuid()) @db.Uuid
  title     String
  date      DateTime
  closedAt  DateTime?
  createdBy String    @db.Uuid
  createdAt DateTime  @default(now())

  attendees   MeetingAttendee[]
  assignments KpiAssignment[]

  @@index([date])
  @@index([closedAt])
  @@map("meeting")
}
